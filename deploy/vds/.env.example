# Copy to .env next to docker-compose.yml and fill in ONE of the two modes.

# --- Mode 1: a domain (recommended) ---------------------------------------------------------
# A DNS A/AAAA record for this name must point at the server. Certificates come from
# Let's Encrypt automatically.
DOMAIN=
EMAIL=

# --- Mode 2: IP only ------------------------------------------------------------------------
# Leave DOMAIN empty and set the server's public IP. A self-signed certificate is created on
# first start; paste its pin (see `docker compose logs signal`) into the app.
PUBLIC_IP=

# --- Optional -------------------------------------------------------------------------------
# Public address coturn advertises when the server sits behind 1:1 NAT (most cloud VMs with a
# private interface): "public-ip" or "public-ip/private-ip".
TURN_EXTERNAL_IP=
# TURN ports (open them in the firewall: 3478 tcp+udp, 5349 tcp, and the relay range udp).
TURN_PORT=3478
TURNS_PORT=5349
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
# Lifetime of the TURN credentials handed out, in seconds.
TURN_TTL=3600
LOG_LEVEL=info

# Secrets are NOT set here: the TURN shared secret (and the IP-mode certificate) are generated
# on first start and kept in the vds_data volume.
